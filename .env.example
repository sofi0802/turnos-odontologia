# Direcciones de la base vistas DESDE TU MÁQUINA: las usan ./gradlew bootRun y los tests de integración.
# Con "docker compose up -d", el compose reemplaza DB_URL solo dentro del contenedor del backend
# (jdbc:postgresql://postgres:5432/turnos), así que estas no hace falta cambiarlas.
# Si publicaste la base en otro puerto con un docker-compose.override.yml (por ejemplo 5433), cambiá el puerto acá.
DB_URL=jdbc:postgresql://localhost:5432/turnos
DB_USER=turnos
DB_PASSWORD=cambiar
DB_TEST_URL=jdbc:postgresql://localhost:5432/turnos_test
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false
APP_CORS_ORIGENES=http://localhost:5173
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123
NOTIFICACIONES_BASE_URL=http://localhost:5173
CONSULTORIO_NOMBRE=Consultorio Ejemplo
CONSULTORIO_DIRECCION=Calle Ficticia 123
NOTIFICACIONES_RUTA_CANCELAR=/mis-turnos/cancelar
NOTIFICACIONES_RUTA_REPROGRAMAR=/mis-turnos/reprogramar
# Dónde guarda el backend las imágenes clínicas cuando corre con bootRun (por defecto ./data/imagenes).
# En Docker la fija el compose en el volumen turnos-imagenes.
# IMAGENES_DIRECTORIO=./data/imagenes
IMAGENES_DIRECTORIO=./data/imagenes
PAGOS_PASARELA=simulada
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PAGOS_URL_PUBLICA=http://localhost:8080